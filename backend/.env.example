# Bu faylni nusxalab `.env` yarating:  cp .env.example .env
# .env fayli git'ga qo'shilmaydi (.gitignore da bor).

# Yangi SECRET_KEY generatsiya qilish:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-new-secret-key

# Lokal ishlab chiqishda True, productionda False
DEBUG=True

# Vergul bilan ajratilgan hostlar
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend manzillari (CORS)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (Docker yoki lokal)
# DATABASE_URL=postgres://postgres:password@localhost:5432/talabahub

# ===== AI yordamchi (ixtiyoriy) =====
# OpenAI-mos API kaliti. Bepul variantlar: Groq, OpenRouter.
# Masalan OpenAI: AI_BASE_URL=https://api.openai.com/v1 , AI_MODEL=gpt-4o-mini
# Masalan Groq:   AI_BASE_URL=https://api.groq.com/openai/v1 , AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ===== Email (parol tiklash uchun) =====
# Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ===== Google OAuth =====
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
